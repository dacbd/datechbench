{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "bench": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "description": "Path of the bench YAML the run was started from."
        },
        "hash": {
          "type": "string",
          "description": "sha256 of the bench definition minus its model list; changes whenever questions, modes or the system prompt do."
        }
      },
      "required": [
        "name",
        "file",
        "hash"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "string",
      "description": "\"local\" for the inference router, otherwise the gateway provider prefix."
    },
    "model": {
      "type": "string",
      "description": "Model id as written in the bench."
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ],
      "description": "null if the process died mid-run."
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "failure": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "incomplete",
            "interrupted",
            "harness_error",
            "model_errors"
          ],
          "description": "Why the run is a failure. incomplete: the process died mid-run (this is what the file says until the run finishes). interrupted: stopped by SIGINT/SIGTERM. harness_error: the bench code threw. model_errors: the run finished, but the bench type reported errors such as failed requests or hitting the output limit."
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "message"
      ],
      "additionalProperties": false
    },
    "results": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "shuffle",
                  "isolated"
                ]
              }
            },
            "correct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Questions in the bench."
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "correct / total."
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "choices": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The choices in the random order they were presented; letters below index into this."
                  },
                  "expected": {
                    "type": "string",
                    "description": "Letter of the correct choice in the presented order."
                  },
                  "chosen": {
                    "description": "Letter the model submitted (presented order), or null if it never answered.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "correct": {
                    "type": "boolean"
                  },
                  "failureReason": {
                    "description": "Present if and only if correct is false.",
                    "type": "string",
                    "enum": [
                      "wrong_answer",
                      "no_tool_call",
                      "wrong_tool",
                      "invalid_tool_input",
                      "output_limit",
                      "request_error"
                    ]
                  },
                  "error": {
                    "description": "Detail for tool/request failures.",
                    "type": "string"
                  },
                  "finishReason": {
                    "description": "Why generation stopped, as reported by the AI SDK (stop, length, tool-calls, ...); null if the request failed.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "durationMs": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Time the model request took."
                  },
                  "tokens": {
                    "type": "object",
                    "properties": {
                      "input": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "Prompt tokens, including earlier turns of the session."
                      },
                      "output": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "Tokens generated, including reasoning tokens."
                      },
                      "reasoning": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "Thinking tokens, a subset of output. 0 if the provider does not report them."
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "input",
                      "output",
                      "reasoning",
                      "total"
                    ],
                    "additionalProperties": false
                  },
                  "transcript": {
                    "type": "array",
                    "items": {},
                    "description": "Messages exchanged for this question: the prompt, the model response, and the tool result. Without isolated mode, earlier questions' transcripts precede it in the conversation."
                  }
                },
                "required": [
                  "id",
                  "choices",
                  "expected",
                  "chosen",
                  "correct",
                  "finishReason",
                  "durationMs",
                  "tokens",
                  "transcript"
                ],
                "additionalProperties": false
              },
              "description": "Questions asked so far, in order."
            },
            "stats": {
              "type": "object",
              "properties": {
                "wallTimeMs": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Elapsed real time for the whole run."
                },
                "apiTimeMs": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Time spent waiting on model requests, summed over questions."
                },
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Prompt tokens across all questions, including earlier turns of each session."
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Generated tokens across all questions, including reasoning tokens."
                },
                "totalTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Input plus output tokens across all questions."
                },
                "avgTokensPerSecond": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Generated (output) tokens divided by api time; 0 if there was no api time."
                }
              },
              "required": [
                "wallTimeMs",
                "apiTimeMs",
                "inputTokens",
                "outputTokens",
                "totalTokens",
                "avgTokensPerSecond"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "modes",
            "correct",
            "total",
            "score",
            "questions",
            "stats"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "bench",
    "provider",
    "model",
    "startedAt",
    "finishedAt",
    "status",
    "results"
  ],
  "additionalProperties": false
}
